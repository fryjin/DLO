{
  "name": "dopamine-cloud-lite",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check app.js && node --check src/worker.js && node --check scripts/create-accounts.mjs && npm test && npm run build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dopamine-cloud-lite --local",
    "db:migrate:remote": "wrangler d1 migrations apply dopamine-cloud-lite --remote",
    "credentials:create": "node scripts/create-accounts.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
